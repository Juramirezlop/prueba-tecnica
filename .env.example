# Cadena de conexion a PostgreSQL.
# Formato: postgresql+psycopg2://usuario:password@host:puerto/base_datos
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prueba_tecnica

# Clave secreta usada para firmar las sesiones/tokens. Cambiar en produccion.
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Duracion de la sesion en minutos.
SESSION_EXPIRE_MINUTES=120
